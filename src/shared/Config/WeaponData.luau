--!strict
--[[
	WeaponData.luau
	The forty WILDBREAK firearms.

	Every weapon is data only: no behaviour lives in this file. Statistics are
	balanced against each other through a shared budget so that no two weapons
	differ solely by name or skin. Each entry declares:
	  * combat stats (damage, rate of fire, range, recoil, handling, mobility)
	  * ammunition and reload behaviour
	  * weak-point behaviour and specialised effects
	  * attachment slots, Beast Core compatibility and evolution paths
	  * the id of its signature Ultimate (see WeaponUltimates.luau)
]]

local Enums = require(script.Parent.Parent.Constants.Enums)

export type FirearmInput = {
	id: string,
	displayName: string,
	class: string,
	rarity: string,
	damage: number,
	rpm: number,
	fireMode: string,
	magazine: number,
	reserve: number,
	reloadTime: number,
	range: number,
	falloffStart: number?,
	spread: number, -- degrees, hip fire
	adsSpread: number,
	recoilVertical: number,
	recoilHorizontal: number,
	adsTime: number,
	switchTime: number,
	mobility: number, -- walk speed multiplier
	weakPointMultiplier: number,
	headMultiplier: number?,
	damageType: string,
	ammoType: string,
	projectile: string?,
	projectileSpeed: number?,
	pellets: number?,
	burstCount: number?,
	chargeTime: number?,
	ultimateId: string,
	attachmentSlots: { string },
	coreCompatibility: { string },
	unlockLevel: number,
	special: string?,
	description: string,
}

export type WeaponDef = FirearmInput & {
	kind: string,
	evolutions: { string }?,
}

local function firearm(input: FirearmInput): WeaponDef
	local def = table.clone(input) :: any
	def.kind = Enums.WeaponKind.Firearm
	def.projectile = input.projectile or Enums.ProjectileKind.Hitscan
	def.pellets = input.pellets or 1
	def.falloffStart = input.falloffStart or input.range * 0.6
	def.headMultiplier = input.headMultiplier or input.weakPointMultiplier
	def.special = input.special or nil
	return def :: WeaponDef
end

